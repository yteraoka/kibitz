project_id = "my-project"
region     = "asia-northeast1"

# Images built from this repository. See docs/deployment.md.
server_image = "asia-northeast1-docker.pkg.dev/my-project/kibitz/kibitz-server:v0.1.0"
worker_image = "asia-northeast1-docker.pkg.dev/my-project/kibitz/kibitz-worker:v0.1.0"
scaler_image = "asia-northeast1-docker.pkg.dev/my-project/kibitz/kibitz-scaler:v0.1.0"

# From the GitHub App's settings page.
github_app_id          = "123456"
github_installation_id = "7890123"

# kibitz が自分の発言を無視するためのアカウント名。通常は空でよい。
# サーバーは GitHub が付ける App の id で、ワーカーは GitHub に問い合わせた
# slug で自分を判別するため、手で書く必要は無い。
# App をリネームした後も旧アカウント名を無視したい、といった場合にだけ設定する。
bot_logins = []

# Repositories kibitz will accept webhooks for.
allowed_repos = ["my-org/*"]

# コメントで kibitz に話しかけるときの書き方。GitHub 側では単なる文字列で、
# GitHub App は @ メンションできないので、この値を GitHub が解釈することはない。
# ただし **同名のアカウントが実在すればその人に通知が飛ぶ** (public リポジトリの場合)。
# ユーザー名になり得ない形にしておけば通知は発生しない。
#
#   mention = "/kibitz"
mention = "/kibitz"

# レビューを依頼するキーワード。空にすると全 PR をレビューする。
# 設定すると、タイトルか本文にこれらか /kibitz を含む PR だけが publish される
# (コメントでの依頼は常に有効)。無駄なメッセージが減り、worker が 0 インスタンス
# に落ちやすくなる。
#
#   trigger_keywords = ["/review", "[review]", "レビュー希望"]
trigger_keywords = []

# server は署名を検証して publish するだけなので、1 台で相当な数の delivery を
# さばける。この上限は負荷に合わせるためではなく、delivery が殺到したときの
# 上限を決めるためのもの。burst で webhook が弾かれるようなら上げる。
server_max_instances = 1

# worker のインスタンス数は Pub/Sub のバックログから決まる。0 は「キューが空なら
# 何も動かさない」で、これが既定。常時 1 台温めておきたい場合だけ 1 にする。
worker_min_instances         = 0
worker_max_instances         = 3
worker_messages_per_instance = 2
worker_idle_after            = "15m"

# Create a notification channel first, or nobody is told when an alert fires:
#   gcloud alpha monitoring channels create --display-name=... --type=email \
#     --channel-labels=email_address=team@example.com
alert_notification_channels = []

# Model. Gemini on Vertex AI needs no access request and authenticates with the
# worker's own service account, so it needs no secret.
#
#   model = "google-vertex/gemini-3.1-pro-preview"   # 既定
#   model = "google-vertex/gemini-3.8-flash"         # 安価・高速
#   model = "google-vertex/claude-opus-5@default"    # Anthropic の利用申請が必要
#
# Vertex Model Garden のパートナーモデル (GLM など) も同じ認証で使える。
# opencode のカタログに無いので kibitz がプロバイダを宣言する。シークレット不要。
#
#   model = "vertex-maas/zai-org/glm-5.2-maas"
#
# Z.AI などに直接つなぐ場合は、キーを入れる変数名を指定する。
# Secret Manager のシークレットが作られるので、値は gcloud で投入する。
#
#   model                  = "zai/glm-5.3"
#   model_api_key_env_name = "ZHIPU_API_KEY"
