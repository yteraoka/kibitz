# kibitz-worker: consumes events and runs the agent engine.
#
# Unlike the server this image needs a userland: git to fetch pull requests,
# ripgrep for the agent's search tool, the opencode binary, and a Node.js
# runtime for MCP servers started as local processes. The base is therefore
# node rather than distroless.
FROM golang:1.27 AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY . .
ARG VERSION=dev
RUN CGO_ENABLED=0 go build -trimpath \
        -ldflags "-s -w -X main.version=${VERSION}" \
        -o /out/kibitz-worker ./cmd/kibitz-worker \
    && CGO_ENABLED=0 go build -trimpath \
        -ldflags "-s -w -X main.version=${VERSION}" \
        -o /out/kibitz-mcp ./cmd/kibitz-mcp

FROM node:22-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        fd-find \
        git \
        ripgrep \
    && rm -rf /var/lib/apt/lists/* \
    # pi's find tool runs "fd" and, when it is missing, tries to download it.
    # Debian ships it as fdfind.
    && ln -s /usr/bin/fdfind /usr/local/bin/fd

# Pinned rather than "latest": the agent's behaviour is part of kibitz's
# output, so it changes when kibitz is released, not when upstream publishes.
#
# --ignore-scripts stops every dependency's install hooks from running, but
# opencode ships its actual binary as a platform-specific optional dependency
# and its own postinstall is what puts that binary in place. `npm rebuild` runs
# the hooks for that one package and nothing else, which keeps the rest of the
# tree from executing code at build time.
#
# Which binary is chosen is decided here, not at runtime: the postinstall reads
# the build machine's CPU features, so a build under emulation picks the
# baseline variant. That runs anywhere, which is the safe direction.
ARG OPENCODE_VERSION=1.18.31
RUN npm install -g --ignore-scripts "opencode-ai@${OPENCODE_VERSION}" \
    && npm rebuild -g opencode-ai \
    && opencode --version

# pi, the engine on trial (ADR-0024). It runs only when KIBITZ_AGENT_ENGINE
# is "pi"; the image carries it so that trying it is a variable, not a build.
# Pinned for the same reason opencode is.
ARG PI_VERSION=1.0.0
RUN npm install -g --ignore-scripts "@earendil-works/pi-coding-agent@${PI_VERSION}" \
    && pi --version

COPY --from=build /out/kibitz-worker /usr/local/bin/kibitz-worker

# kibitz's own MCP server. opencode starts it per job to answer questions about
# the pull request; it holds no credential and reads one file the worker wrote.
COPY --from=build /out/kibitz-mcp /usr/local/bin/kibitz-mcp

# The agent definitions kibitz runs with. They are part of the image, not of
# the repository under review: a pull request must not be able to rewrite the
# instructions its own reviewer follows.
COPY deploy/opencode/agents/ /etc/kibitz/opencode/agents/

# pi has no permissions of its own; this extension is what keeps its tools
# inside the checkout. Like the agent definitions it is part of the image.
COPY deploy/pi/kibitz-guard.ts /etc/kibitz/pi/kibitz-guard.ts

# Workspaces are disposable; one clone per job, removed afterwards.
RUN useradd --create-home --uid 10001 kibitz \
    && mkdir -p /var/tmp/kibitz /home/kibitz/.config/opencode \
    && cp -r /etc/kibitz/opencode/agents /home/kibitz/.config/opencode/agents \
    && chown -R kibitz:kibitz /var/tmp/kibitz /home/kibitz

EXPOSE 8081
USER kibitz
ENV HOME=/home/kibitz
ENTRYPOINT ["/usr/local/bin/kibitz-worker"]
